<?xml version="1.0"?>
<package format="3">
  <name>tof_ground_seg_cpp</name>
  <version>0.0.1</version>
  <description>C++ port of the ToF ground segmentation node with readable helpers and simple tuning points.</description>

  <maintainer email="you@todo.com">you</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
